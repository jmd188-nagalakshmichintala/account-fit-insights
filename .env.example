# Databricks connection (required)
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_WAREHOUSE_ID=your-warehouse-id

# Genie chatbot (REST API only — the SQL warehouse connection above keeps using OAuth)
# Leave unset to disable the chat widget until you've created your own Genie space.
DATABRICKS_GENIE_SPACE_ID=your-genie-space-id
DATABRICKS_LOCAL_PAT=your-service-principal-pat

# M2M OAuth (only needed when deployed, not for local dev)
# DATABRICKS_CLIENT_ID=your-client-id
# DATABRICKS_CLIENT_SECRET=your-client-secret

# App configuration
DATABRICKS_APP_PORT=8000
GONG_BASE_URL=https://app.gong.io
